<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoundBoard.UI.ViewModels"
             xmlns:controls="using:SoundBoard.UI.Controls"
             x:Class="SoundBoard.UI.Views.PoppedShortcutPageView"
             x:DataType="vm:PoppedShortcutPageViewModel">

    <UserControl.Styles>
        <Style Selector="ItemsControl > ContentPresenter > Button">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="ItemsControl > ContentPresenter > Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>

        <!-- Fluent's Button template forces Background + BorderBrush to theme
             colors on :pointerover and :pressed, hiding the playing/paused
             outline and the per-button background color. Re-bind both to the
             Button's own values so they show through. -->
        <Style Selector="ItemsControl > ContentPresenter > Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
        </Style>
        <Style Selector="ItemsControl > ContentPresenter > Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *" Margin="10">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="6,0,0,10">
            <TextBlock Grid.Column="0" Text="{Binding PageName}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center" />
            <!-- Shared board lock (same state as the main window). -->
            <ToggleButton Grid.Column="1" IsChecked="{Binding IsLocked, Mode=TwoWay}"
                          Padding="10,3" CornerRadius="6"
                          ToolTip.Tip="Locked: tap to play/pause, long-press to stop. Unlock to drag-reorder.">
                <Panel>
                    <TextBlock Text="🔒 Locked" IsVisible="{Binding IsLocked}" />
                    <TextBlock Text="🔓 Unlocked" IsVisible="{Binding !IsLocked}" />
                </Panel>
            </ToggleButton>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ShortcutItems" ItemsSource="{Binding CurrentButtons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="120" ItemHeight="120" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding ClickCommand}"
                                BorderBrush="{Binding OutlineBrush}"
                                BorderThickness="3"
                                CornerRadius="8"
                                Margin="10"
                                Padding="0"
                                Background="{Binding ButtonBrush}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <!-- Full-size centered icon layer with the label in front.
                                 Mirrors ShortcutsView; see it for the full rationale. -->
                            <Panel>
                                <Viewbox IsVisible="{Binding HasIcon}" Stretch="Uniform" Margin="14"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:RpgIcon IconName="{Binding EffectiveIcon}"
                                                      FontSize="48"
                                                      Foreground="{Binding IconBrush}" />
                                </Viewbox>
                                <controls:OutlinedTextBlock Text="{Binding Label}"
                                                            FontSize="13" FontWeight="Bold"
                                                            TextAlignment="Center"
                                                            Foreground="{Binding LabelForeground}"
                                                            Stroke="{Binding LabelOutline}" StrokeThickness="3"
                                                            ShadowBrush="{Binding LabelShadow}"
                                                            Margin="5"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
