<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoundBoard.UI.ViewModels"
             xmlns:controls="using:SoundBoard.UI.Controls"
             x:Class="SoundBoard.UI.Views.ShortcutsView"
             x:DataType="vm:ShortcutsViewModel">

    <UserControl.Styles>
        <Style Selector="ItemsControl > ContentPresenter > Button">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="ItemsControl > ContentPresenter > Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>

        <!-- Fluent's Button template forces Background + BorderBrush to theme
             colors on :pointerover and :pressed, which would hide the
             playing/paused outline AND clobber the per-button background
             color override. Re-bind both to the Button's own values (bound to
             ButtonBrush / OutlineBrush on the VM) so the state colours show
             through. Hover feedback still comes from the scale(1.04) transform
             above. -->
        <Style Selector="ItemsControl > ContentPresenter > Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
        </Style>
        <Style Selector="ItemsControl > ContentPresenter > Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- Row 0: Page Tabs (scrollable) + Page Management actions.
             The TabStrip is wrapped in a horizontal ScrollViewer so a long
             list of pages clips at the column boundary instead of running
             under the action buttons, and a scrollbar appears when the tabs
             don't fit. The "+" (Add Page) and "Pop Out" buttons share the
             right-side column so they stay anchored and visible regardless
             of how many tabs are present, scrolled, or selected.
             Mouse-wheel-to-horizontal-scroll is wired in code-behind. -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <ScrollViewer Grid.Column="0"
                          x:Name="PageTabsScroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          PointerWheelChanged="OnPageTabsWheel">
                <!-- Bottom inset keeps the tab labels clear of the overlay
                     horizontal scrollbar that floats over the viewport's
                     bottom edge when the tabs overflow. -->
                <TabStrip x:Name="PageTabs" Margin="0,0,0,10"
                          ItemsSource="{Binding VisiblePages}" SelectedItem="{Binding SelectedPage}">
                    <TabStrip.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Padding="10,5"
                                       DoubleTapped="OnPageTabDoubleTapped">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename Page..." Click="OnRenamePageClicked" />
                                        <MenuItem Header="Hide Page" Click="OnHidePageClicked" />
                                        <MenuItem Header="Delete Page" Click="OnDeletePageClicked" />
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="10,0,0,0">
                <!-- Board lock. Locked (default) disables reordering buttons and
                     tabs so the board is safe to tap during a session; long-press
                     then stops a track instead of starting a drag. Unlock to
                     rearrange. One lock governs all pages + popped windows. -->
                <ToggleButton IsChecked="{Binding IsLocked, Mode=TwoWay}" Padding="10,3" CornerRadius="6"
                              ToolTip.Tip="Locked: tap to play/pause, long-press to stop. Unlock to drag-reorder buttons and tabs.">
                    <Panel>
                        <TextBlock Text="🔒 Locked" IsVisible="{Binding IsLocked}" />
                        <TextBlock Text="🔓 Unlocked" IsVisible="{Binding !IsLocked}" />
                    </Panel>
                </ToggleButton>

                <!-- Add Page Button -->
                <Button Content="+" FontSize="18" FontWeight="Bold" Padding="10,3"
                        Background="{DynamicResource SuccessBackground}" Foreground="{DynamicResource SuccessForeground}" CornerRadius="6"
                        ToolTip.Tip="Add new page" Command="{Binding AddPageCommand}" />

                <!-- Hidden tabs overflow. Only shows when at least one page
                     is hidden — keeps the toolbar clean otherwise. Each row
                     in the flyout lists a hidden page's name with a
                     one-click "Show" button that flips IsHidden=false. -->
                <Button Content="Hidden tabs ▾" ToolTip.Tip="Show hidden pages"
                        IsVisible="{Binding HasHiddenPages}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding HiddenPages}" MinWidth="240">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*, Auto" Margin="4">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="▸ Show" Padding="8,2"
                                                        Click="OnShowHiddenPageClicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Content="Pop Out 🗗" Command="{Binding PopOutCommand}" Classes="primary" />
            </StackPanel>
        </Grid>

        <!-- Row 1: Dynamic Grid of Shortcut Buttons -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ShortcutItems"
                          ItemsSource="{Binding CurrentButtons}"
                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="120" ItemHeight="120" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding ClickCommand}"
                                BorderBrush="{Binding OutlineBrush}"
                                BorderThickness="3"
                                CornerRadius="8"
                                Margin="10"
                                Background="{Binding ButtonBrush}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnButtonDragOver"
                                DragDrop.Drop="OnButtonDrop"
                                Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✏ Rename..." Click="OnRenameButtonClicked" />
                                    <MenuItem Header="🎨 Set icon..." Click="OnSetButtonIconClicked" />
                                    <MenuItem Header="🖌 Icon color..." Click="OnSetButtonIconColorClicked" />
                                    <MenuItem Header="🟦 Button color..." Click="OnSetButtonColorClicked" />
                                    <MenuItem Header="🎛 FX Chain..." Click="OnConfigureShortcutSamplersClicked" />
                                    <MenuItem Header="🎚 Bus override..." Click="OnSetButtonBusOverrideClicked"
                                              IsVisible="{Binding IsTrackTarget}" />
                                    <Separator />
                                    <MenuItem Header="🗑 Remove" Click="OnRemoveButtonClicked" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <!-- Icon is a full-size, always-centered background layer;
                                 the label renders in front of it. Over an icon (or a
                                 custom button color) the label uses white text with a
                                 dark outline + drop shadow so it stays legible without
                                 covering the icon; plain text-only buttons render the
                                 theme text color with no outline/shadow. -->
                            <Panel>
                                <Viewbox IsVisible="{Binding HasIcon}" Stretch="Uniform" Margin="14"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:RpgIcon IconName="{Binding EffectiveIcon}"
                                                      FontSize="48"
                                                      Foreground="{Binding IconBrush}" />
                                </Viewbox>
                                <controls:OutlinedTextBlock Text="{Binding Label}"
                                                            FontSize="13" FontWeight="Bold"
                                                            TextAlignment="Center"
                                                            Foreground="{Binding LabelForeground}"
                                                            Stroke="{Binding LabelOutline}" StrokeThickness="3"
                                                            ShadowBrush="{Binding LabelShadow}"
                                                            Margin="5"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- Corner menu affordance: a touch target that opens
                                     the button's context menu (so touch users don't need
                                     right-click / a press-hold gesture). As a nested
                                     Button it is ignored by the drag + long-press
                                     controllers and never triggers play/pause. Top-right
                                     so it clears the centered icon and label. -->
                                <Button Click="OnShortcutMenuButtonClicked"
                                        Content="⋮" FontSize="18" FontWeight="Bold"
                                        Width="30" Height="30" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Background="#66000000" Foreground="White" CornerRadius="6"
                                        ToolTip.Tip="Options" />
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
